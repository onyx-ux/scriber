# Dependencies
node_modules/

# Secrets / local config — never commit these
.env
pi-service/rclone/rclone.conf
pc-sync/config/rclone.conf

# Timestamped copies of the above, which the bare `.env` line does NOT catch:
# it matches a file called exactly `.env`, and `.env.bak-20260816-170133` is a
# different filename. Four of those were sitting untracked-but-not-ignored in
# pi-service/ with live DISCORD_TOKEN, GEMINI_API_KEY and STATUS_TOKEN values in
# them — one `git add -A` from a public repo. `.env.example` is deliberately
# still tracked; neither pattern below matches it.
.env.bak*
*.bak-*

# Runtime data written by the bot (SQLite db, audio, whisper models, Obsidian export)
pi-service/data/
pi-service/models/
pi-service/obsidian-export/
*.db
*.db-journal
*.wav

# OS / editor cruft
.DS_Store
Thumbs.db

# Whisper model files for the PC-side GPU server (1.5GB+, downloaded locally)
pc-whisper/models/

# Dashboard credentials
dashboard/config/.htpasswd
dashboard/.env

# Agent skills installed via `npx skills add` (third-party content + local symlinks).
# skills-lock.json is deliberately NOT ignored - it records which skills are
# installed so they can be reinstalled reproducibly.
.agents/
.claude/skills/

# Rollback points taken before a deploy — see backups/README.md. Local only:
# they exist so a bad ship can be undone from the machine that shipped it, and
# a snapshot of a working tree does not belong in the history of that tree.
backups/

# Design exports and scratch. The UI zip is 4MB of binary that would sit in
# history for ever once pushed, and it is a build output rather than a source.
*.zip
temp.md
# Single-file design-tool exports (`Quill Landing Page.dc.html` and friends).
# Same reasoning as the zip: they are a render of a design, not a source the
# dashboard is built from, and each save writes a whole new copy of the file.
*.dc.html
