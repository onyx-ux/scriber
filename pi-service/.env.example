# Discord Developer Portal -> your application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: force all notes into one specific channel instead of posting
# back into whichever text channel the voice session happened near.
NOTES_CHANNEL_ID=
# Send finished notes to OWNER_USER_ID's DMs instead of a server channel, so
# one bot can serve several servers without each needing a notes channel set
# up. Falls back to the channel if the DM can't be opened (Discord lets people
# refuse DMs from bots). Requires OWNER_USER_ID below.
NOTES_TO_OWNER_DM=false

# Which model writes the session summary.
#   gemini    — sends the finished TRANSCRIPT TEXT to Gemini (default). Has a
#               free tier, and the default model below is Google's cheapest.
#   anthropic — sends it to Claude instead. Paid-tier only (no free tier).
# Audio and transcription are ALWAYS local — only the transcript text leaves
# the network, never the recordings.
#
# A local option (Ollama) was removed: on a 12GB card a 14B model took ~7.5
# minutes per transcript slice — about an hour for a session Gemini does in
# under a minute — and wasn't as good. The trade-off is that summarising now
# needs the internet; without it, jobs queue and retry.
SUMMARY_PROVIDER=gemini
# Required when SUMMARY_PROVIDER=anthropic (startup fails without it).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Required when SUMMARY_PROVIDER=gemini (startup fails without it). Get a key
# at https://aistudio.google.com/apikey. flash-lite is Gemini's budget tier —
# pick this provider for the lowest-cost cloud summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Park finished transcripts until you explicitly approve them, instead of
# summarising the moment transcription ends. Stops a summary firing on your
# PC in the middle of a game. You get a DM with an approve button; /pending
# and /approve work too. Leave false to summarise automatically as before.
SUMMARY_REQUIRE_APPROVAL=false
# Discord user ID that approval DMs go to. Without it the job still parks
# safely, there's just no DM — release it with /approve or /pending.
OWNER_USER_ID=

# Render NPC/location names as [[wikilinks]] in the exported markdown so
# Obsidian's graph links sessions to the campaign ledger. Set false for plain text.
OBSIDIAN_WIKILINKS=true

# whisper.cpp model. Options (in order of increasing size/accuracy/CPU cost):
# tiny.en, base.en, small.en, medium.en, large-v3-turbo (multilingual, not
# English-only, but still excellent on English and the most accurate option).
# Transcription runs in the background after /leave, not live, so a slower/
# more accurate model is usually worth it unless the Pi is very underpowered.
# The model file is downloaded automatically on first start under this name
# (WHISPER_MODEL_PATH defaults from this — only set it explicitly for a
# custom location).
WHISPER_MODEL_NAME=base.en
WHISPER_THREADS=4
# Language pinned rather than auto-detected. The multilingual models
# (large-v3-turbo, large-v3) will occasionally decide a short, noisy clip is
# another language and transcribe it that way — and a session is hundreds of
# short clips. English-only models (*.en) ignore this.
WHISPER_LANGUAGE=en

# Transcribe on another machine's GPU instead of the Pi's CPU. This is by far
# the biggest speed lever in the whole pipeline: measured 0.17s per clip on an
# RTX 3080 Ti vs ~69s on the Pi — about 400x. A 30-minute session goes from
# ~4.5 hours to under a minute. Audio still never leaves your LAN; this is
# your own PC (see pc-whisper/docker-compose.yml to run the server).
# Leave unset to transcribe on the Pi.
WHISPER_SERVER_URL=
# If the GPU machine is off, fall back to the Pi's CPU: slow, but a session is
# never lost. Set false to fail instead and retry later on the GPU.
WHISPER_LOCAL_FALLBACK=true

# whisper encodes a fixed 30-second window no matter how short the audio is,
# and Discord gives one short clip per speaking turn — so transcribing them
# one at a time wastes nearly all of that (a real 235-clip session took ~4.5
# hours). With batching on, clips from the SAME speaker are merged to fill
# those windows: measured 5.3x faster, with speakers still 100% correct.
# The cost is ragged line breaks and per-line timestamps that drift by a few
# seconds (whisper's word timing on merged audio isn't precise enough to
# split a one-second clip cleanly). Summaries are unaffected — the summariser
# reads the whole transcript — but the raw transcript reads choppier.
# 'auto' spends that accuracy only where it buys something: unbatched (clean)
# when transcription runs on the GPU server, where a clip costs ~0.17s and a
# session is over in minutes anyway; batched when it runs on the Pi's CPU at
# ~65s per encode window, where 5x decides whether it's done by morning. That
# includes a WHISPER_SERVER_URL that's configured but switched off.
# true/false force it either way.
TRANSCRIBE_BATCHING=auto

# How aggressively to retry summarization when the PC is off
SUMMARIZE_RETRY_BASE_MS=60000
SUMMARIZE_RETRY_MAX_MS=1800000
SUMMARIZE_MAX_ATTEMPTS=0

# --- When a finished recording may use the PC's GPU ---
#
# Transcription is the only step that reaches into another machine's hardware,
# and that machine is usually also the one being played on. So a finished
# session is queued rather than transcribed immediately, and runs when either
# the owner approves it or it falls inside the automatic window below.
# Nothing here ever falls back to transcribing on the Pi on its own: an
# unattended fallback would spend hours of CPU for a worse transcript, and
# waiting costs nothing but time. /transcribe (or the DM buttons) can send a
# session to the Pi deliberately.

# The zone every hour and weekday below is interpreted in. The container runs
# in UTC, so this must be set for a window to mean what you think it does.
SCHEDULE_TIMEZONE=Australia/Brisbane

# Ask before touching the GPU at all: you get a DM with Transcribe now /
# Remind me later / Use the Pi instead. Set false to let the automatic window
# do everything silently. Needs OWNER_USER_ID to have somewhere to ask.
TRANSCRIBE_REQUIRE_APPROVAL=true

# The hours a queued session may transcribe without being asked — the PC is
# typically on but nobody is on it. End hour is exclusive, so 8-16 is the last
# job starting at 15:59. A window that wraps past midnight (22-6) also works.
TRANSCRIBE_WINDOW_START_HOUR=8
TRANSCRIBE_WINDOW_END_HOUR=16
# Weekends never auto-run — that's when the PC is most likely to be in use.
# You still get a DM, and the button still works. Set false to include them.
TRANSCRIBE_WEEKDAYS_ONLY=true

# "Remind me later" pushes a session out by this many hours, and doubles as
# the reminder interval for a session nobody has actioned.
TRANSCRIBE_SNOOZE_HOURS=24
# How often the queue is checked. Cheap — it only probes the PC when there is
# actually something waiting.
TRANSCRIBE_POLL_MS=60000

# Once a session is transcribed and archived, move the recording here for the
# PC to collect (see pc-sync/), so a long campaign doesn't fill the Pi's card.
# A handover point, not storage: AUDIO_RETENTION_DAYS still ages it out if the
# PC never collects. Only ever reached AFTER the transcript is committed, so
# the Pi never gives up its only copy of something it hasn't transcribed.
# Leave blank to keep recordings on the Pi.
AUDIO_OFFLOAD_DIR=/data/audio-outbox

# Auto-delete a completed session's audio after this many days (0 = keep forever)
AUDIO_RETENTION_DAYS=14

# Once the transcript is safely stored, collapse the session's hundreds of
# per-utterance WAV fragments into ONE compressed recording in the same
# folder, and delete the fragments. Far smaller, and actually listenable —
# the fragments never were. AUDIO_RETENTION_DAYS then ages the archive out on
# the normal schedule.
# The trade-off is per-speaker separation: the archive is a single mixed
# timeline, so re-transcribing it later recovers the words but not reliably
# who said them. Set false to keep the raw fragments (~4x the disk) instead.
# A failed archive never deletes anything.
AUDIO_ARCHIVE=true

# Where Obsidian-ready markdown gets written (bind-mount this to your vault sync folder)
OBSIDIAN_EXPORT_DIR=/data/obsidian

# Google Drive sync via rclone (see README "Google Drive sync" section for setup).
# Off by default. DRIVE_REMOTE_NAME must match the remote name from `rclone config`.
DRIVE_SYNC_ENABLED=false
# Uploads ONE compressed recording of the whole session (~64kbps mono MP3,
# built from the same per-utterance clips transcription uses, but laid out
# on a real timeline instead of hundreds of separate tiny files) — not the
# raw fragment directory. Off by default: even compressed, a long session is
# still tens of MB.
DRIVE_SYNC_AUDIO=false
DRIVE_REMOTE_NAME=gdrive
DRIVE_REMOTE_PATH=DnDSessions
