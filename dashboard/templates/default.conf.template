# The landing page and the dashboard, and the only things that should ever
# face a URL.
#
# Two audiences on one server: strangers, who get the landing page at / and
# nothing else, and the table, who get the dashboard at /app/ once they are on
# the LAN or know the password. See the gate below — it is the whole security
# story of this file.
#
# nginx:alpine runs envsubst over /etc/nginx/templates/*.template at start-up,
# so ${PI_API} and ${STATUS_TOKEN} come from the environment rather than being
# baked into an image or committed to git. Only those two names are on
# envsubst's list, so nginx's own $variables below are left alone.

# ── Arriving through the Cloudflare tunnel ───────────────────────────────
#
# The dashboard now has two front doors: the LAN, on port 8095, and
# https://quill.thehouseofcake.org, which reaches this container from the
# cloudflared sidecar on the compose network. Everything below exists because
# those two look identical to nginx unless it is told how to tell them apart.
#
# Cloudflare stamps both of these at its own edge and overwrites whatever the
# visitor sent, so neither can be forged from outside. They are only believed
# from the docker network cloudflared sits on -- see set_real_ip_from below --
# so nothing on the LAN can put words in Cloudflare's mouth either.

# Whether the BROWSER is on https, which is not the same question as whether
# this server is. Cloudflare terminates TLS at its edge and speaks plain http
# down the tunnel, so $scheme here says "http" for a visitor whose address bar
# says https. The bot uses this to decide whether the session cookie may carry
# Secure, and getting it wrong either drops the cookie on a LAN page or leaves
# it unprotected behind real TLS.
map $http_cf_visitor $forwarded_proto {
    default   $scheme;   # nobody in front of us: whatever we are actually serving
    "~*https" https;     # Cloudflare terminated TLS for us
    "~*http"  http;
}

server {
    listen 80;
    server_name _;

    # Judge a tunnel request on where the PERSON is, not where the tunnel is.
    #
    # Without this, every request through the tunnel arrives from cloudflared's
    # container address -- which allowed-ips.conf waves straight through as
    # "docker's own bridge networks", handing the entire dashboard and its API
    # to anybody on the internet who knows the hostname, with no password at
    # all. That is not a hypothetical: it is what happens the moment the tunnel
    # comes up, unless $remote_addr is rewritten first.
    #
    # realip runs before the access phase, so by the time allow/deny is
    # consulted a tunnel request already carries the visitor's real address and
    # the docker line no longer matches it. The LAN is untouched: its requests
    # carry no CF-Connecting-IP, so nothing is rewritten.
    #
    # set_real_ip_from is deliberately narrow. Trusting a header from anywhere
    # is how an allow-list becomes a suggestion.
    #
    # Both entries are the same machine wearing different hats. cloudflared
    # runs on the host's network, so its requests reach this container through
    # a published port and arrive as either the bridge gateway or the loopback
    # depending on how docker routed them — and if the address it actually
    # arrives on is NOT listed here, CF-Connecting-IP is ignored, the request
    # keeps an internal address, and allowed-ips.conf waves the whole internet
    # straight through. Verify with the access log rather than assuming: the
    # line for a request through the tunnel must show the visitor's public
    # address, never 127.0.0.1 or a 172.x one.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;

    # Relative redirects. nginx builds an absolute Location out of the port it
    # is listening on, which is 80 in here and never the port the browser
    # actually used — so http://pi:8095/app sent people to http://pi/app/ and
    # a dead connection. A relative Location is resolved by the browser
    # against the URL it already has, which is right every time.
    absolute_redirect off;

    # ── What is public, and what is not ──────────────────────────────────
    #
    # The gate used to sit here, at server level, so it covered everything.
    # The landing page is meant to be read by strangers, and a marketing page
    # behind a password prompt is not a marketing page — so the gate moved
    # down into the two locations that still want it, and only the landing
    # page was let out.
    #
    # `satisfy any` is the lockdown itself: a request passes if EITHER its
    # address is on the allow list OR it carries valid credentials. The LAN
    # stays frictionless and anything from outside has to log in. Without
    # `satisfy any` the two are ANDed and the house is asked for a password
    # as well.
    #
    # It is repeated rather than factored into an include on purpose. This is
    # a security boundary, and a boundary you can read in one place beats one
    # you have to go and look up.

    # The front door.
    #
    # Exact matches, both of them. A prefix `location /` here would hand out
    # everything under the document root to anybody — including
    # /index.html, which IS the dashboard sitting at its raw path. The
    # landing page pulls nothing local (Google Fonts and one link, that is
    # all), so two exact paths cover it completely.
    #
    # GATED FOR NOW, which it was not before the hostname existed. The landing
    # page is written to be read by strangers and a marketing page behind a
    # password is not a marketing page — but it only became reachable by
    # strangers today, and "let the world in" is a decision to make awake and
    # on purpose rather than a side effect of switching a tunnel on.
    #
    # To open it: delete the five gate lines from each of these two blocks and
    # `docker compose restart dashboard`. Nothing else has to change, and the
    # dashboard itself stays behind its own gate below either way.
    location = / {
        satisfy any;
        include /etc/nginx/allowed-ips.conf;
        deny all;
        auth_basic "Scriber";
        auth_basic_user_file /etc/nginx/.htpasswd;

        root /usr/share/nginx/html;
        try_files /quill-landing.html =404;
    }
    location = /quill-landing.html {
        satisfy any;
        include /etc/nginx/allowed-ips.conf;
        deny all;
        auth_basic "Scriber";
        auth_basic_user_file /etc/nginx/.htpasswd;

        root /usr/share/nginx/html;
    }

    # Everything else under the root, /index.html included, stays gated.
    location / {
        satisfy any;
        include /etc/nginx/allowed-ips.conf;
        deny all;
        auth_basic "Scriber";
        auth_basic_user_file /etc/nginx/.htpasswd;

        root /usr/share/nginx/html;
    }

    # The dashboard, one level in. It used to be the root; it moved when the
    # landing page took that spot, because the two serve different people and
    # only one of them should be the first thing a stranger meets.
    #
    # An exact match, and `try_files` rather than `alias` + `index`: there is
    # nothing under /app/ to serve but index.html, and this spelling has none
    # of alias's footguns.
    #
    # The page does now load one file of its own — /dash/morph.js — and this
    # block still does not have to become a prefix location, because that file
    # is not under /app/. It is an absolute path, so the catch-all `location /`
    # below answers it, with the same five gate lines and the same document
    # root. Checked rather than assumed: through the tunnel from an address off
    # the allow list, /dash/morph.js answers 401 exactly as /app/ does, and
    # from the LAN it answers 200 as application/javascript.
    #
    # A file added under /app/ ITSELF would still need the prefix location.
    # Putting new ones next to morph.js is the cheaper habit.
    #
    # The dashboard's own API constant is '/api', rooted at the host rather
    # than relative, so serving the page from /app/ does not disturb it.
    #
    # The bare /app redirect is deliberately outside the gate: it reveals
    # nothing, and prompting for a password only to then redirect is a
    # confusing way to meet a login box. The destination asks.
    location = /app  { return 301 /app/; }
    location = /app/ {
        satisfy any;
        include /etc/nginx/allowed-ips.conf;
        deny all;
        auth_basic "Scriber";
        auth_basic_user_file /etc/nginx/.htpasswd;

        root /usr/share/nginx/html;
        try_files /index.html =404;
    }

    # The gatehouse, which decides who may sign in at all.
    #
    # Its own address rather than a tab inside the dashboard, and unlinked from
    # anywhere a player will look. That is not the security: the security is
    # that /status simply does not contain the roster for anybody but the
    # owner, and access/invite, access/uninvite and access/revoke are all
    # refused below dev. An unguessed URL guards nothing on its own. It is here
    # so that four out of five people with the dashboard open are never shown a
    # door they cannot go through.
    #
    # Gated exactly like /app/, so it is reachable from wherever the dashboard
    # is. If you would rather it never answered through the tunnel at all,
    # delete `satisfy any;` from this block alone: the allow-list then becomes
    # a requirement rather than an alternative, the LAN keeps working, and a
    # visitor arriving from outside is refused whatever password they know.
    location = /gatehouse  { return 301 /gatehouse/; }
    location = /gatehouse/ {
        satisfy any;
        include /etc/nginx/allowed-ips.conf;
        deny all;
        auth_basic "Scriber";
        auth_basic_user_file /etc/nginx/.htpasswd;

        root /usr/share/nginx/html;
        try_files /gatehouse.html =404;
    }

    # The status API, proxied so the token never reaches the browser.
    #
    # The page used to call the Pi directly, which meant every viewer needed
    # to reach port 8090 themselves and any token would have been sitting in
    # the page source. Here it is added server-side, and the Pi's API can stay
    # bound to the LAN even when the dashboard is public.
    #
    # Gated like the dashboard. Quill's own sign-in lives inside this, not
    # instead of it: /api/auth/* is how a player gets a session, and it is
    # still only reachable by someone who is already past this door.
    #
    # Two of those three routes are BROWSER NAVIGATIONS rather than fetches —
    # /api/auth/discord redirects out to Discord, and Discord redirects back to
    # /api/auth/callback. That second one is the address registered in the
    # Discord developer portal, and it is what DISCORD_REDIRECT_URI has to say
    # (the bot derives exactly this from DASHBOARD_URL when it is unset). It
    # needs nothing special here: proxy_pass forwards the query string, the
    # state cookie rides in the Cookie header, and the bot's 302 back to /app/
    # is relative, so the browser resolves it against whatever host and port it
    # actually used.
    location /api/ {
        satisfy any;
        include /etc/nginx/allowed-ips.conf;
        deny all;
        auth_basic "Scriber";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass ${PI_API}/;
        proxy_set_header X-Status-Token "${STATUS_TOKEN}";
        proxy_set_header Host $host;
        # Whether the browser is actually on https, which decides whether the
        # session cookie may carry Secure. Setting Secure on a LAN http page
        # would mean the browser silently discards it and nobody can sign in;
        # not setting it once this is behind TLS would be sloppier than
        # necessary.
        #
        # $scheme is the wrong answer through the tunnel — Cloudflare holds the
        # TLS and speaks plain http to us — so this comes from the map at the
        # top of the file, which asks Cloudflare what the browser is on and
        # falls back to $scheme when there is no Cloudflare in front.
        #
        # Cookies themselves need no configuration here: nginx forwards the
        # request Cookie header and passes Set-Cookie back by default.
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # A dashboard that hangs for a minute because the Pi is rebooting is
        # worse than one that says "unreachable" in three seconds.
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;

        # The page polls; a cached status is a lie.
        add_header Cache-Control "no-store" always;
    }
}
